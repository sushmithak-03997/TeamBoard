    {
      "name": "11. Admin Usage Summary - ADMIN Success (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('Response has total_queries, active_companies, top_search_terms', function () {",
              "    pm.expect(body).to.have.property('total_queries');",
              "    pm.expect(body).to.have.property('active_companies');",
              "    pm.expect(body).to.have.property('top_search_terms');",
              "    pm.expect(body.top_search_terms).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
