{
  "info": {
    "name": "TeamBoard Knowledge Base API",
    "description": "Covers all 11 required scenarios for register, login, KB query, and admin usage-summary endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "client_access_token",
      "value": ""
    },
    {
      "key": "client_api_key",
      "value": ""
    },
    {
      "key": "admin_access_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Register - Success (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "pm.test('Response has access token and api_key', function () {",
              "    pm.expect(body).to.have.property('access');",
              "    pm.expect(body).to.have.property('api_key');",
              "});",
              "pm.collectionVariables.set('client_access_token', body.access);",
              "pm.collectionVariables.set('client_api_key', body.api_key);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"acmecorp\",\n  \"password\": \"securepass123\",\n  \"company_name\": \"Acme Corp\",\n  \"email\": \"dev@acmecorp.com\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/register/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "register",
            ""
          ]
        }
      }
    },
    {
      "name": "2. Register - Duplicate Username (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 400', function () { pm.response.to.have.status(400); });",
              "pm.test('Response mentions username error', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property('username');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"acmecorp\",\n  \"password\": \"anotherpass456\",\n  \"company_name\": \"Acme Corp Duplicate\",\n  \"email\": \"other@acmecorp.com\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/register/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "register",
            ""
          ]
        }
      }
    },
    {
      "name": "3. Login - Success (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('Response has access, company_name, api_key', function () {",
              "    pm.expect(body).to.have.property('access');",
              "    pm.expect(body).to.have.property('company_name');",
              "    pm.expect(body).to.have.property('api_key');",
              "});",
              "pm.collectionVariables.set('client_access_token', body.access);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"acmecorp\",\n  \"password\": \"securepass123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "login",
            ""
          ]
        }
      }
    },
