          "mode": "raw",
          "raw": "{\n  \"username\": \"acmecorp\",\n  \"password\": \"wrongpassword\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "login",
            ""
          ]
        }
      }
    },
    {
      "name": "5. KB Query - No Token (401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 401', function () { pm.response.to.have.status(401); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"search\": \"select_related\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/kb/query/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "kb",
            "query",
            ""
          ]
        }
      }
    },
    {
      "name": "6. KB Query - Valid Search With Results (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('Response has search, count, results', function () {",
              "    pm.expect(body).to.have.property('search');",
              "    pm.expect(body).to.have.property('count');",
              "    pm.expect(body).to.have.property('results');",
              "});",
              "pm.test('Count matches results length', function () {",
              "    pm.expect(body.count).to.eql(body.results.length);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{client_access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"search\": \"select_related\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/kb/query/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "kb",
            "query",
            ""
          ]
        }
      }
    },
